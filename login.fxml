<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.finance.manager.controller.LoginController"
            prefHeight="600.0" prefWidth="800.0"
            stylesheets="@../css/style.css">
    <center>
        <StackPane>
            <children>
                <VBox styleClass="login-pane" maxWidth="400" maxHeight="450" spacing="20">
                    <padding>
                        <Insets top="30" right="40" bottom="30" left="40"/>
                    </padding>
                    
                    <!-- Title -->
                    <HBox alignment="CENTER">
                        <VBox alignment="CENTER" spacing="10">
                            <ImageView fitHeight="80" fitWidth="80" preserveRatio="true">
                                <Image url="@../images/logo.png"/>
                            </ImageView>
                            <Label styleClass="login-title" text="Personal Finance Management System"/>
                        </VBox>
                    </HBox>
                    
                    <!-- Form -->
                    <VBox spacing="15">
                        <!-- Username input -->
                        <VBox spacing="5">
                            <Label text="Username"/>
                            <TextField fx:id="usernameField" styleClass="input-field" promptText="Enter username or phone number"/>
                        </VBox>
                        
                        <!-- Password input -->
                        <VBox spacing="5">
                            <Label text="Password"/>
                            <PasswordField fx:id="passwordField" styleClass="input-field" promptText="Enter password"/>
                        </VBox>
                        
                        <!-- Error message display -->
                        <Text fx:id="errorText" fill="RED" visible="false" managed="false"/>
                        
                        <!-- Login button -->
                        <Button fx:id="loginButton" styleClass="login-button" text="Login" onAction="#handleLogin" maxWidth="Infinity"/>
                        
                        <!-- Links area -->
                        <HBox spacing="10" alignment="CENTER">
                            <Button fx:id="forgotPasswordButton" styleClass="link-button" text="Forgot Password" onAction="#handleForgotPassword"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="registerButton" styleClass="link-button" text="Register New Account" onAction="#handleRegister"/>
                        </HBox>
                    </VBox>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane> 