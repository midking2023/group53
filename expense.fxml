<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.finance.manager.controller.ExpenseController"
      prefHeight="600.0" prefWidth="800.0"
      styleClass="content-area" spacing="10">
    
    <!-- 顶部标题和导航 -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="支出分析" styleClass="page-title"/>
        <HBox alignment="CENTER_RIGHT" spacing="10" HBox.hgrow="ALWAYS">
            <Button fx:id="prevButton" text="上一页：首页" onAction="#handlePrevPage"/>
            <Button fx:id="nextButton" text="下一页：手动分类" onAction="#handleNextPage"/>
        </HBox>
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
    </HBox>
    
    <!-- 内容区域 -->
    <VBox VBox.vgrow="ALWAYS" styleClass="content-box">
        <Label text="支出分析内容将显示在这里" alignment="CENTER"/>
    </VBox>
</VBox>
