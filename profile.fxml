                                        
                                        <Label text="Email:" GridPane.rowIndex="1">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="emailField" promptText="Please enter your email" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                        
                                        <Label text="Phone:" GridPane.rowIndex="2">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="phoneField" promptText="Please enter your phone number" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>
                        
                        <Separator />
                        
                        <!-- 偏好设置部分 -->
                        <VBox spacing="15.0">
                            <children>
                                <Label styleClass="section-title" text="Preferences">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <GridPane hgap="15.0" vgap="15.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="80.0" prefWidth="120.0" />
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" prefWidth="350.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <Label text="Language:" GridPane.rowIndex="0">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                        <ComboBox fx:id="languageComboBox" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <items>
                                                <FXCollections fx:factory="observableArrayList">
                                                    <String fx:value="English" />
                                                    <String fx:value="Chinese" />
                                                </FXCollections>
                                            </items>
                                        </ComboBox>
                                        
                                        <Label text="Currency:" GridPane.rowIndex="1">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                        <ComboBox fx:id="currencyComboBox" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <items>
                                                <FXCollections fx:factory="observableArrayList">
                                                    <String fx:value="USD ($)" />
                                                    <String fx:value="CNY (¥)" />
                                                    <String fx:value="EUR (€)" />
                                                    <String fx:value="GBP (£)" />
                                                </FXCollections>
                                            </items>
                                        </ComboBox>
                                        
                                        <Label text="Region:" GridPane.rowIndex="2">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                        <ComboBox fx:id="regionComboBox" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <items>
                                                <FXCollections fx:factory="observableArrayList">
                                                    <String fx:value="China" />
                                                    <String fx:value="USA" />
                                                    <String fx:value="Europe" />
                                                </FXCollections>
                                            </items>
                                        </ComboBox>
                                        
                                        <Label text="Notifications:" GridPane.rowIndex="3">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                        <CheckBox fx:id="notificationCheckBox" text="Enable notifications" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </CheckBox>
                                    </children>
                                </GridPane>
                            </children>
                        </VBox>
                        
                        <Separator />
                        
                        <!-- 支付方式部分 -->
                        <VBox spacing="15.0">
                            <children>
                                <Label styleClass="section-title" text="Payment Methods">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <HBox spacing="20.0">
                                    <children>
                                        <CheckBox fx:id="alipayCheckBox" mnemonicParsing="false" text="Alipay">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </CheckBox>
                                        <CheckBox fx:id="wechatCheckBox" mnemonicParsing="false" text="WeChat Pay">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </CheckBox>
                                        <CheckBox fx:id="bankCardCheckBox" mnemonicParsing="false" text="Bank Card">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </CheckBox>
                                        <CheckBox fx:id="creditCardCheckBox" mnemonicParsing="false" text="Credit Card">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </CheckBox>
                                        <CheckBox fx:id="cashCheckBox" mnemonicParsing="false" text="Cash">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </CheckBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                        
                        <!-- 状态显示 -->
                        <Text fx:id="statusText" fill="GREEN" strokeType="OUTSIDE" strokeWidth="0.0">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Text>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="20.0" styleClass="footer-background" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <children>
                <Button fx:id="resetButton" mnemonicParsing="false" onAction="#handleReset" styleClass="reset-button" text="Reset">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
                <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSave" styleClass="save-button" text="Save Changes">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </bottom>
</BorderPane> 
